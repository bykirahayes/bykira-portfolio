{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bykira-enquiry",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "contact.bykira.co.uk", "custom_domain": true }],
  "ratelimits": [{ "name": "ENQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "ENQUIRY_FROM": "By Kira website <enquiries@send.bykira.co.uk>" }
}
